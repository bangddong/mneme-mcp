# 로컬 LLM 런타임 (OpenAI 호환). Ollama 기본; NPU는 Foundry Local로 base URL 교체.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
WIKI_DIR=E:/development/wiki
DB_PATH=./memory/state.db
MCP_HOST=0.0.0.0
MCP_PORT=8080
# Outer Loop 정산 주기(분)
OUTER_LOOP_INTERVAL_MIN=10
# Discord 웹훅 알림 (복습 필요 등). 비우면 자동 비활성화.
# 발급: Discord 채널 설정 → 연동 → 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=
